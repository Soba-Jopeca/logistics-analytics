JSON Gold Dashboard Logistica =

VAR Inicio = MIN(fPedidos[Data_Pedido])
VAR Fim = MAX(fPedidos[Data_Pedido])
VAR MesesComPedidos = SUMMARIZE(fPedidos, dCalendario[AnoMes])
VAR TotalMeses = COALESCE(COUNTROWS(MesesComPedidos), 0)
-- Datas de cobertura e de referência descrevem a fonte. Os fatos serializados continuam no contexto dos filtros.
VAR PrimeiroDiaFonte = CALCULATE(MIN(fPedidos[Data_Pedido]), REMOVEFILTERS())
VAR UltimoDiaFonte = CALCULATE(MAX(fPedidos[Data_Pedido]), REMOVEFILTERS())
VAR AtualizacaoFonte = CALCULATE(MAX(fPedidos[Data_Atualizacao]), REMOVEFILTERS())
VAR DatasNoRecorte =
    FILTER(VALUES(dCalendario[Data]), dCalendario[Data] >= PrimeiroDiaFonte && dCalendario[Data] <= UltimoDiaFonte)
VAR CalendarioComparavelJSON =
    "[" & CONCATENATEX(MesesComPedidos,
        VAR Mes = dCalendario[AnoMes]
        VAR PrimeiroDia = DATE(VALUE(LEFT(Mes, 4)), VALUE(RIGHT(Mes, 2)), 1)
        VAR UltimoDia = EOMONTH(PrimeiroDia, 0)
        VAR DatasDoMes = FILTER(DatasNoRecorte, dCalendario[Data] >= PrimeiroDia && dCalendario[Data] <= UltimoDia)
        RETURN "{""m"":""" & Mes & """,""dias"":[" &
            CONCATENATEX(DatasDoMes, FORMAT(DAY(dCalendario[Data]), "0", "en-US"), ",", dCalendario[Data], ASC) & "]}",
        ",", dCalendario[AnoMes], ASC) & "]"
VAR DescricaoPeriodo =
    IF(NOT ISBLANK(Inicio), FORMAT(Inicio, "dd/MM/yyyy", "pt-BR") & " a " & FORMAT(Fim, "dd/MM/yyyy", "pt-BR"))
VAR Contexto =
    IF(TotalMeses = 0, "Nenhum pedido no contexto filtrado.",
        FORMAT([Total de pedidos], "#,0", "pt-BR") & " pedidos em " &
        FORMAT(TotalMeses, "0", "pt-BR") & " meses pela data do pedido no contexto dos filtros do relatório.")
-- Meses completos para as comparações que precisam de datas fora do recorte atual.
VAR MesesParaComparar =
    DISTINCT(UNION(MesesComPedidos, FILTER(VALUES(dCalendario[AnoMes]), HASONEVALUE(dCalendario[AnoMes]))))
VAR MesesAnterioresNecessarios =
    DISTINCT(SELECTCOLUMNS(MesesParaComparar,
        "@MesAnterior", FORMAT(EDATE(DATE(VALUE(LEFT(dCalendario[AnoMes], 4)), VALUE(RIGHT(dCalendario[AnoMes], 2)), 1), -1), "yyyy-MM", "en-US")))
VAR MesesAnterioresForaDoRecorte =
    FILTER(MesesAnterioresNecessarios,
        VAR MesAnterior = [@MesAnterior]
        VAR DiasVisiveis = CALCULATE(COUNTROWS(dCalendario), KEEPFILTERS(dCalendario[AnoMes] = MesAnterior))
        VAR DiasDoMes = CALCULATE(COUNTROWS(dCalendario), REMOVEFILTERS(dCalendario), dCalendario[AnoMes] = MesAnterior)
        RETURN COALESCE(DiasVisiveis, 0) < DiasDoMes)
VAR GruposAtuais =
ADDCOLUMNS(
    SUMMARIZE(fPedidos, dCalendario[AnoMes], dDestino[Regiao_Destino], dTransportadora[Transportadora], fPedidos[Data_Pedido], dModal[Modal], dProduto[Categoria_Produto], dProduto[Produto], fPedidos[Motivo_Atraso], dStatus[Status_Entrega]),
    "@qt", [Quantidade de itens],
    "@p", [Total de pedidos],
    "@q", [Pedidos OTIF],
    "@pe", [Pedidos elegíveis para OTIF],
    "@vp", [Valor dos pedidos],
    "@cp", [Custo logístico],
    "@ln", [Lead times válidos],
    "@co", [Emissões de CO₂],
    "@an", [Atrasos válidos],
    "@dv", [Pedidos com devolução],
    "@av", [Pedidos com avaria],
    "@ex", [Pedidos extraviados],
    "@en", [Pedidos entregues],
    "@pa", [Pedidos com status Atrasado],
    "@ea", [Entregas atrasadas],
    "@ai", [Entregas com atraso informado],
    "@nn", [Avaliações válidas],
    "@lt", [Lead time médio] * [Lead times válidos],
    "@at", [Atraso médio das entregas atrasadas] * [Atrasos válidos],
    "@ns", [Nota média do cliente] * [Avaliações válidas]
)
VAR GruposComparacao =
    CALCULATETABLE(
ADDCOLUMNS(
    SUMMARIZE(fPedidos, dCalendario[AnoMes], dDestino[Regiao_Destino], dTransportadora[Transportadora], fPedidos[Data_Pedido], dModal[Modal], dProduto[Categoria_Produto], dProduto[Produto], fPedidos[Motivo_Atraso], dStatus[Status_Entrega]),
    "@qt", [Quantidade de itens],
    "@p", [Total de pedidos],
    "@q", [Pedidos OTIF],
    "@pe", [Pedidos elegíveis para OTIF],
    "@vp", [Valor dos pedidos],
    "@cp", [Custo logístico],
    "@ln", [Lead times válidos],
    "@co", [Emissões de CO₂],
    "@an", [Atrasos válidos],
    "@dv", [Pedidos com devolução],
    "@av", [Pedidos com avaria],
    "@ex", [Pedidos extraviados],
    "@en", [Pedidos entregues],
    "@pa", [Pedidos com status Atrasado],
    "@ea", [Entregas atrasadas],
    "@ai", [Entregas com atraso informado],
    "@nn", [Avaliações válidas],
    "@lt", [Lead time médio] * [Lead times válidos],
    "@at", [Atraso médio das entregas atrasadas] * [Atrasos válidos],
    "@ns", [Nota média do cliente] * [Avaliações válidas]
),
        REMOVEFILTERS(dCalendario),
        TREATAS(MesesAnterioresForaDoRecorte, dCalendario[AnoMes])
    )
RETURN
"{""meta"":" & "{""periodo"":" & (VAR TextoJSON = DescricaoPeriodo
 RETURN IF(ISBLANK(TextoJSON), "null",
    UNICHAR(34) & CONCATENATEX(
        GENERATESERIES(1, LEN(TextoJSON)),
        VAR Caractere = MID(TextoJSON, [Value], 1)
        VAR Codigo = UNICODE(Caractere)
        RETURN SWITCH(TRUE(),
            Codigo = 34, "\""",
            Codigo = 92, "\\",
            Codigo = 47, "\/",
            Codigo < 32, "\u00" & MID("0123456789abcdef", INT(Codigo / 16) + 1, 1) & MID("0123456789abcdef", MOD(Codigo, 16) + 1, 1),
            Caractere),
        "", [Value], ASC
    ) & UNICHAR(34))) &
    ",""dataInicial"":" & (VAR TextoJSON = IF(NOT ISBLANK(Inicio), FORMAT(Inicio, "yyyy-MM-dd", "en-US"))
 RETURN IF(ISBLANK(TextoJSON), "null",
    UNICHAR(34) & CONCATENATEX(
        GENERATESERIES(1, LEN(TextoJSON)),
        VAR Caractere = MID(TextoJSON, [Value], 1)
        VAR Codigo = UNICODE(Caractere)
        RETURN SWITCH(TRUE(),
            Codigo = 34, "\""",
            Codigo = 92, "\\",
            Codigo = 47, "\/",
            Codigo < 32, "\u00" & MID("0123456789abcdef", INT(Codigo / 16) + 1, 1) & MID("0123456789abcdef", MOD(Codigo, 16) + 1, 1),
            Caractere),
        "", [Value], ASC
    ) & UNICHAR(34))) &
    ",""dataFinal"":" & (VAR TextoJSON = IF(NOT ISBLANK(Fim), FORMAT(Fim, "yyyy-MM-dd", "en-US"))
 RETURN IF(ISBLANK(TextoJSON), "null",
    UNICHAR(34) & CONCATENATEX(
        GENERATESERIES(1, LEN(TextoJSON)),
        VAR Caractere = MID(TextoJSON, [Value], 1)
        VAR Codigo = UNICODE(Caractere)
        RETURN SWITCH(TRUE(),
            Codigo = 34, "\""",
            Codigo = 92, "\\",
            Codigo = 47, "\/",
            Codigo < 32, "\u00" & MID("0123456789abcdef", INT(Codigo / 16) + 1, 1) & MID("0123456789abcdef", MOD(Codigo, 16) + 1, 1),
            Caractere),
        "", [Value], ASC
    ) & UNICHAR(34))) &
    ",""quantidadeMeses"":" & (VAR NumeroJSON = TotalMeses RETURN IF(ISBLANK(NumeroJSON), "null", FORMAT(NumeroJSON, IF(NumeroJSON = TRUNC(NumeroJSON), "0", "0.0###############"), "en-US"))) &
    ",""mesReferencia"":" & (VAR TextoJSON = SELECTEDVALUE(dCalendario[AnoMes])
 RETURN IF(ISBLANK(TextoJSON), "null",
    UNICHAR(34) & CONCATENATEX(
        GENERATESERIES(1, LEN(TextoJSON)),
        VAR Caractere = MID(TextoJSON, [Value], 1)
        VAR Codigo = UNICODE(Caractere)
        RETURN SWITCH(TRUE(),
            Codigo = 34, "\""",
            Codigo = 92, "\\",
            Codigo = 47, "\/",
            Codigo < 32, "\u00" & MID("0123456789abcdef", INT(Codigo / 16) + 1, 1) & MID("0123456789abcdef", MOD(Codigo, 16) + 1, 1),
            Caractere),
        "", [Value], ASC
    ) & UNICHAR(34))) &
    ",""contexto"":" & (VAR TextoJSON = Contexto
 RETURN IF(ISBLANK(TextoJSON), "null",
    UNICHAR(34) & CONCATENATEX(
        GENERATESERIES(1, LEN(TextoJSON)),
        VAR Caractere = MID(TextoJSON, [Value], 1)
        VAR Codigo = UNICODE(Caractere)
        RETURN SWITCH(TRUE(),
            Codigo = 34, "\""",
            Codigo = 92, "\\",
            Codigo = 47, "\/",
            Codigo < 32, "\u00" & MID("0123456789abcdef", INT(Codigo / 16) + 1, 1) & MID("0123456789abcdef", MOD(Codigo, 16) + 1, 1),
            Caractere),
        "", [Value], ASC
    ) & UNICHAR(34))) &
    ",""fonte"":" & (VAR TextoJSON = "base_logistica_simulada_brasil.xlsx / TabelaBaseLogistica"
 RETURN IF(ISBLANK(TextoJSON), "null",
    UNICHAR(34) & CONCATENATEX(
        GENERATESERIES(1, LEN(TextoJSON)),
        VAR Caractere = MID(TextoJSON, [Value], 1)
        VAR Codigo = UNICODE(Caractere)
        RETURN SWITCH(TRUE(),
            Codigo = 34, "\""",
            Codigo = 92, "\\",
            Codigo = 47, "\/",
            Codigo < 32, "\u00" & MID("0123456789abcdef", INT(Codigo / 16) + 1, 1) & MID("0123456789abcdef", MOD(Codigo, 16) + 1, 1),
            Caractere),
        "", [Value], ASC
    ) & UNICHAR(34))) &
    ",""fonteAtualizadaEm"":" & (VAR TextoJSON = IF(NOT ISBLANK(AtualizacaoFonte), FORMAT(AtualizacaoFonte, "yyyy-MM-dd", "en-US"))
 RETURN IF(ISBLANK(TextoJSON), "null",
    UNICHAR(34) & CONCATENATEX(
        GENERATESERIES(1, LEN(TextoJSON)),
        VAR Caractere = MID(TextoJSON, [Value], 1)
        VAR Codigo = UNICODE(Caractere)
        RETURN SWITCH(TRUE(),
            Codigo = 34, "\""",
            Codigo = 92, "\\",
            Codigo = 47, "\/",
            Codigo < 32, "\u00" & MID("0123456789abcdef", INT(Codigo / 16) + 1, 1) & MID("0123456789abcdef", MOD(Codigo, 16) + 1, 1),
            Caractere),
        "", [Value], ASC
    ) & UNICHAR(34))) &
    ",""baseSimulada"":" & "true" &
    ",""calendarioComparavel"":" & CalendarioComparavelJSON &
    "}" &
    ",""kpis"":" & "{""pedidos"":" & (VAR NumeroJSON = [Total de pedidos] RETURN IF(ISBLANK(NumeroJSON), "null", FORMAT(NumeroJSON, IF(NumeroJSON = TRUNC(NumeroJSON), "0", "0.0###############"), "en-US"))) &
    ",""itens"":" & (VAR NumeroJSON = [Quantidade de itens] RETURN IF(ISBLANK(NumeroJSON), "null", FORMAT(NumeroJSON, IF(NumeroJSON = TRUNC(NumeroJSON), "0", "0.0###############"), "en-US"))) &
    ",""valorPedidos"":" & (VAR NumeroJSON = [Valor dos pedidos] RETURN IF(ISBLANK(NumeroJSON), "null", FORMAT(NumeroJSON, IF(NumeroJSON = TRUNC(NumeroJSON), "0", "0.0###############"), "en-US"))) &
    ",""custoLogistico"":" & (VAR NumeroJSON = [Custo logístico] RETURN IF(ISBLANK(NumeroJSON), "null", FORMAT(NumeroJSON, IF(NumeroJSON = TRUNC(NumeroJSON), "0", "0.0###############"), "en-US"))) &
    ",""custoPorPedido"":" & (VAR NumeroJSON = [Custo logístico por pedido] RETURN IF(ISBLANK(NumeroJSON), "null", FORMAT(NumeroJSON, IF(NumeroJSON = TRUNC(NumeroJSON), "0", "0.0###############"), "en-US"))) &
    ",""custoSobreValorPedidos"":" & (VAR NumeroJSON = [Custo logístico sobre valor dos pedidos] RETURN IF(ISBLANK(NumeroJSON), "null", FORMAT(NumeroJSON, IF(NumeroJSON = TRUNC(NumeroJSON), "0", "0.0###############"), "en-US"))) &
    ",""entregues"":" & (VAR NumeroJSON = [Pedidos entregues] RETURN IF(ISBLANK(NumeroJSON), "null", FORMAT(NumeroJSON, IF(NumeroJSON = TRUNC(NumeroJSON), "0", "0.0###############"), "en-US"))) &
    ",""statusAtrasado"":" & (VAR NumeroJSON = [Pedidos com status Atrasado] RETURN IF(ISBLANK(NumeroJSON), "null", FORMAT(NumeroJSON, IF(NumeroJSON = TRUNC(NumeroJSON), "0", "0.0###############"), "en-US"))) &
    ",""statusAtrasadoPercentual"":" & (VAR NumeroJSON = [Pedidos com status Atrasado %] RETURN IF(ISBLANK(NumeroJSON), "null", FORMAT(NumeroJSON, IF(NumeroJSON = TRUNC(NumeroJSON), "0", "0.0###############"), "en-US"))) &
    ",""entregasAtrasadas"":" & (VAR NumeroJSON = [Entregas atrasadas] RETURN IF(ISBLANK(NumeroJSON), "null", FORMAT(NumeroJSON, IF(NumeroJSON = TRUNC(NumeroJSON), "0", "0.0###############"), "en-US"))) &
    ",""entregasAtrasadasPercentual"":" & (VAR NumeroJSON = [Entregas atrasadas %] RETURN IF(ISBLANK(NumeroJSON), "null", FORMAT(NumeroJSON, IF(NumeroJSON = TRUNC(NumeroJSON), "0", "0.0###############"), "en-US"))) &
    ",""elegiveisOtif"":" & (VAR NumeroJSON = [Pedidos elegíveis para OTIF] RETURN IF(ISBLANK(NumeroJSON), "null", FORMAT(NumeroJSON, IF(NumeroJSON = TRUNC(NumeroJSON), "0", "0.0###############"), "en-US"))) &
    ",""pedidosOtif"":" & (VAR NumeroJSON = [Pedidos OTIF] RETURN IF(ISBLANK(NumeroJSON), "null", FORMAT(NumeroJSON, IF(NumeroJSON = TRUNC(NumeroJSON), "0", "0.0###############"), "en-US"))) &
    ",""otifPercentual"":" & (VAR NumeroJSON = [OTIF %] RETURN IF(ISBLANK(NumeroJSON), "null", FORMAT(NumeroJSON, IF(NumeroJSON = TRUNC(NumeroJSON), "0", "0.0###############"), "en-US"))) &
    ",""leadTimeMedio"":" & (VAR NumeroJSON = [Lead time médio] RETURN IF(ISBLANK(NumeroJSON), "null", FORMAT(NumeroJSON, IF(NumeroJSON = TRUNC(NumeroJSON), "0", "0.0###############"), "en-US"))) &
    ",""atrasoMedio"":" & (VAR NumeroJSON = [Atraso médio das entregas atrasadas] RETURN IF(ISBLANK(NumeroJSON), "null", FORMAT(NumeroJSON, IF(NumeroJSON = TRUNC(NumeroJSON), "0", "0.0###############"), "en-US"))) &
    ",""devolucoes"":" & (VAR NumeroJSON = [Pedidos com devolução] RETURN IF(ISBLANK(NumeroJSON), "null", FORMAT(NumeroJSON, IF(NumeroJSON = TRUNC(NumeroJSON), "0", "0.0###############"), "en-US"))) &
    ",""avarias"":" & (VAR NumeroJSON = [Pedidos com avaria] RETURN IF(ISBLANK(NumeroJSON), "null", FORMAT(NumeroJSON, IF(NumeroJSON = TRUNC(NumeroJSON), "0", "0.0###############"), "en-US"))) &
    ",""extravios"":" & (VAR NumeroJSON = [Pedidos extraviados] RETURN IF(ISBLANK(NumeroJSON), "null", FORMAT(NumeroJSON, IF(NumeroJSON = TRUNC(NumeroJSON), "0", "0.0###############"), "en-US"))) &
    ",""emissoesCO2"":" & (VAR NumeroJSON = [Emissões de CO₂] RETURN IF(ISBLANK(NumeroJSON), "null", FORMAT(NumeroJSON, IF(NumeroJSON = TRUNC(NumeroJSON), "0", "0.0###############"), "en-US"))) &
    ",""notaMedia"":" & (VAR NumeroJSON = [Nota média do cliente] RETURN IF(ISBLANK(NumeroJSON), "null", FORMAT(NumeroJSON, IF(NumeroJSON = TRUNC(NumeroJSON), "0", "0.0###############"), "en-US"))) &
    ",""medianaMensalOtif"":" & (VAR NumeroJSON = [Mediana mensal do OTIF] RETURN IF(ISBLANK(NumeroJSON), "null", FORMAT(NumeroJSON, IF(NumeroJSON = TRUNC(NumeroJSON), "0", "0.0###############"), "en-US"))) &
    ",""devolucoesPercentual"":" & (VAR NumeroJSON = [Devoluções %] RETURN IF(ISBLANK(NumeroJSON), "null", FORMAT(NumeroJSON, IF(NumeroJSON = TRUNC(NumeroJSON), "0", "0.0###############"), "en-US"))) &
    ",""avariasPercentual"":" & (VAR NumeroJSON = [Avarias %] RETURN IF(ISBLANK(NumeroJSON), "null", FORMAT(NumeroJSON, IF(NumeroJSON = TRUNC(NumeroJSON), "0", "0.0###############"), "en-US"))) &
    ",""extraviosPercentual"":" & (VAR NumeroJSON = [Extravios %] RETURN IF(ISBLANK(NumeroJSON), "null", FORMAT(NumeroJSON, IF(NumeroJSON = TRUNC(NumeroJSON), "0", "0.0###############"), "en-US"))) &
    ",""variacoesMesAnterior"":" & "{""pedidos"":" & "{""anterior"":" & (VAR NumeroJSON = [Total de pedidos mês anterior] RETURN IF(ISBLANK(NumeroJSON), "null", FORMAT(NumeroJSON, IF(NumeroJSON = TRUNC(NumeroJSON), "0", "0.0###############"), "en-US"))) &
    ",""absoluta"":" & (VAR NumeroJSON = [Total de pedidos variação absoluta] RETURN IF(ISBLANK(NumeroJSON), "null", FORMAT(NumeroJSON, IF(NumeroJSON = TRUNC(NumeroJSON), "0", "0.0###############"), "en-US"))) &
    ",""percentual"":" & (VAR NumeroJSON = [Total de pedidos variação percentual] RETURN IF(ISBLANK(NumeroJSON), "null", FORMAT(NumeroJSON, IF(NumeroJSON = TRUNC(NumeroJSON), "0", "0.0###############"), "en-US"))) &
    "}" &
    ",""otifPercentual"":" & "{""anterior"":" & (VAR NumeroJSON = [OTIF % mês anterior] RETURN IF(ISBLANK(NumeroJSON), "null", FORMAT(NumeroJSON, IF(NumeroJSON = TRUNC(NumeroJSON), "0", "0.0###############"), "en-US"))) &
    ",""absoluta"":" & (VAR NumeroJSON = [OTIF % variação absoluta] RETURN IF(ISBLANK(NumeroJSON), "null", FORMAT(NumeroJSON, IF(NumeroJSON = TRUNC(NumeroJSON), "0", "0.0###############"), "en-US"))) &
    ",""percentual"":" & (VAR NumeroJSON = [OTIF % variação percentual] RETURN IF(ISBLANK(NumeroJSON), "null", FORMAT(NumeroJSON, IF(NumeroJSON = TRUNC(NumeroJSON), "0", "0.0###############"), "en-US"))) &
    "}" &
    ",""custoLogistico"":" & "{""anterior"":" & (VAR NumeroJSON = [Custo logístico mês anterior] RETURN IF(ISBLANK(NumeroJSON), "null", FORMAT(NumeroJSON, IF(NumeroJSON = TRUNC(NumeroJSON), "0", "0.0###############"), "en-US"))) &
    ",""absoluta"":" & (VAR NumeroJSON = [Custo logístico variação absoluta] RETURN IF(ISBLANK(NumeroJSON), "null", FORMAT(NumeroJSON, IF(NumeroJSON = TRUNC(NumeroJSON), "0", "0.0###############"), "en-US"))) &
    ",""percentual"":" & (VAR NumeroJSON = [Custo logístico variação percentual] RETURN IF(ISBLANK(NumeroJSON), "null", FORMAT(NumeroJSON, IF(NumeroJSON = TRUNC(NumeroJSON), "0", "0.0###############"), "en-US"))) &
    "}" &
    ",""leadTimeMedio"":" & "{""anterior"":" & (VAR NumeroJSON = [Lead time médio mês anterior] RETURN IF(ISBLANK(NumeroJSON), "null", FORMAT(NumeroJSON, IF(NumeroJSON = TRUNC(NumeroJSON), "0", "0.0###############"), "en-US"))) &
    ",""absoluta"":" & (VAR NumeroJSON = [Lead time médio variação absoluta] RETURN IF(ISBLANK(NumeroJSON), "null", FORMAT(NumeroJSON, IF(NumeroJSON = TRUNC(NumeroJSON), "0", "0.0###############"), "en-US"))) &
    ",""percentual"":" & (VAR NumeroJSON = [Lead time médio variação percentual] RETURN IF(ISBLANK(NumeroJSON), "null", FORMAT(NumeroJSON, IF(NumeroJSON = TRUNC(NumeroJSON), "0", "0.0###############"), "en-US"))) &
    "}" &
    ",""emissoesCO2"":" & "{""anterior"":" & (VAR NumeroJSON = [Emissões de CO₂ mês anterior] RETURN IF(ISBLANK(NumeroJSON), "null", FORMAT(NumeroJSON, IF(NumeroJSON = TRUNC(NumeroJSON), "0", "0.0###############"), "en-US"))) &
    ",""absoluta"":" & (VAR NumeroJSON = [Emissões de CO₂ variação absoluta] RETURN IF(ISBLANK(NumeroJSON), "null", FORMAT(NumeroJSON, IF(NumeroJSON = TRUNC(NumeroJSON), "0", "0.0###############"), "en-US"))) &
    ",""percentual"":" & (VAR NumeroJSON = [Emissões de CO₂ variação percentual] RETURN IF(ISBLANK(NumeroJSON), "null", FORMAT(NumeroJSON, IF(NumeroJSON = TRUNC(NumeroJSON), "0", "0.0###############"), "en-US"))) &
    "}" &
    "}" &
    "}" &
    ",""series"":" & "{""mensal"":" & ("[" & CONCATENATEX(
    MesesComPedidos,
    "{""m"":" & (VAR TextoJSON = dCalendario[AnoMes]
 RETURN IF(ISBLANK(TextoJSON), "null",
    UNICHAR(34) & CONCATENATEX(
        GENERATESERIES(1, LEN(TextoJSON)),
        VAR Caractere = MID(TextoJSON, [Value], 1)
        VAR Codigo = UNICODE(Caractere)
        RETURN SWITCH(TRUE(),
            Codigo = 34, "\""",
            Codigo = 92, "\\",
            Codigo = 47, "\/",
            Codigo < 32, "\u00" & MID("0123456789abcdef", INT(Codigo / 16) + 1, 1) & MID("0123456789abcdef", MOD(Codigo, 16) + 1, 1),
            Caractere),
        "", [Value], ASC
    ) & UNICHAR(34))) &
    ",""pedidos"":" & (VAR NumeroJSON = [Total de pedidos] RETURN IF(ISBLANK(NumeroJSON), "null", FORMAT(NumeroJSON, IF(NumeroJSON = TRUNC(NumeroJSON), "0", "0.0###############"), "en-US"))) &
    ",""otifPercentual"":" & (VAR NumeroJSON = [OTIF %] RETURN IF(ISBLANK(NumeroJSON), "null", FORMAT(NumeroJSON, IF(NumeroJSON = TRUNC(NumeroJSON), "0", "0.0###############"), "en-US"))) &
    ",""custoLogistico"":" & (VAR NumeroJSON = [Custo logístico] RETURN IF(ISBLANK(NumeroJSON), "null", FORMAT(NumeroJSON, IF(NumeroJSON = TRUNC(NumeroJSON), "0", "0.0###############"), "en-US"))) &
    ",""leadTimeMedio"":" & (VAR NumeroJSON = [Lead time médio] RETURN IF(ISBLANK(NumeroJSON), "null", FORMAT(NumeroJSON, IF(NumeroJSON = TRUNC(NumeroJSON), "0", "0.0###############"), "en-US"))) &
    ",""emissoesCO2"":" & (VAR NumeroJSON = [Emissões de CO₂] RETURN IF(ISBLANK(NumeroJSON), "null", FORMAT(NumeroJSON, IF(NumeroJSON = TRUNC(NumeroJSON), "0", "0.0###############"), "en-US"))) &
    "}",
    ",", dCalendario[AnoMes], ASC
) & "]") &
    "}" &
    ",""rankings"":" & "{""transportadoras"":" & ("[" & CONCATENATEX(
    FILTER(SUMMARIZE(fPedidos, dTransportadora[Transportadora]), NOT ISBLANK(dTransportadora[Transportadora])),
    "{""nome"":" & (VAR TextoJSON = dTransportadora[Transportadora]
 RETURN IF(ISBLANK(TextoJSON), "null",
    UNICHAR(34) & CONCATENATEX(
        GENERATESERIES(1, LEN(TextoJSON)),
        VAR Caractere = MID(TextoJSON, [Value], 1)
        VAR Codigo = UNICODE(Caractere)
        RETURN SWITCH(TRUE(),
            Codigo = 34, "\""",
            Codigo = 92, "\\",
            Codigo = 47, "\/",
            Codigo < 32, "\u00" & MID("0123456789abcdef", INT(Codigo / 16) + 1, 1) & MID("0123456789abcdef", MOD(Codigo, 16) + 1, 1),
            Caractere),
