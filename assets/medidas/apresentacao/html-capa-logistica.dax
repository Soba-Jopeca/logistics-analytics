.cp-intro p { color: var(--cp-muted); max-width: 43ch; margin-top: var(--cp-s4); font-size: clamp(.95rem, 1.4vw, 1.13rem); }
.cp-summary { margin-top: var(--cp-s5); display: flex; flex-wrap: wrap; gap: var(--cp-s3) var(--cp-s5); }
.cp-summary > div { display: grid; gap: var(--cp-s1); border-inline-start: 2px solid var(--cp-accent); padding-inline-start: var(--cp-s2); }
.cp-summary span, .cp-score p, .cp-trend span, .cp-source, .cp-state { color: var(--cp-muted); font-size: .83rem; }
.cp-summary strong { font-size: 1.38rem; line-height: 1.1; font-variant-numeric: tabular-nums; }
.cp-preview { min-width: 0; padding: clamp(var(--cp-s2), 2vw, var(--cp-s4)); background: var(--cp-panel); border: 1px solid var(--cp-border); border-radius: var(--cp-radius); }
.cp-score { display: grid; grid-template-columns: minmax(96px, 146px) minmax(0, 1fr); align-items: center; gap: var(--cp-s3); }
.cp-score h2 { font-size: 1.15rem; line-height: 1.12; }
.cp-score p { margin-top: var(--cp-s1); }
.cp-score .cp-change { color: var(--cp-text); margin-top: var(--cp-s2); }
.cp-change span[data-direction=""up""] { color: var(--cp-up); }
.cp-change span[data-direction=""down""] { color: var(--cp-down); }
.cp-ring { position: relative; aspect-ratio: 1; display: grid; place-items: center; }
.cp-ring svg, .cp-ring-value { grid-area: 1 / 1; }
.cp-ring svg { width: 100%; }
.cp-ring-track, .cp-ring-fill { fill: none; stroke-width: 7; }
.cp-ring-track { stroke: var(--cp-grid); }
.cp-ring-fill { stroke: var(--cp-accent); stroke-linecap: round; }
.cp-ring-value { color: var(--cp-accent); font-size: clamp(1.13rem, 2.15vw, 1.83rem); letter-spacing: -.045em; font-weight: 730; font-variant-numeric: tabular-n" &
    "ums; }
.cp-trend { margin-top: var(--cp-s3); padding-top: var(--cp-s3); border-top: 1px solid var(--cp-border); }
.cp-trend > div:first-child { display: flex; align-items: baseline; flex-wrap: wrap; justify-content: space-between; gap: var(--cp-s1); font-size: .9rem; }
.cp-trend-plot { min-height: 70px; margin-top: var(--cp-s1); color: var(--cp-muted); font-size: .83rem; display: grid; align-items: center; }
.cp-trend svg { display: block; width: 100%; height: 70px; }
.cp-trend-grid { stroke: var(--cp-grid); vector-effect: non-scaling-stroke; }
.cp-trend-line { fill: none; stroke: var(--cp-accent); stroke-width: 2.3; vector-effect: non-scaling-stroke; stroke-linecap: round; stroke-linejoin: round; }
.cp-trend-dot { fill: var(--cp-accent); stroke: var(--cp-panel); stroke-width: 1.5; }
.cp-foot { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: var(--cp-s2); margin-top: var(--cp-s2); }
.cp-source { display: grid; overflow-wrap: anywhere; padding-block: var(--cp-s1); }
.cp-slot { block-size: 60px; inline-size: min(230px, 29vw); }
.cp-screen-reader { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
.cp-road { position: relative; isolation: isolate; overflow: hidden; block-size: var(--cp-road-size); border-block: 1px solid var(--cp-road-edge); background: var(--cp-road-bed); pointer-events: none; }
.cp-road::before { content: """"; position: absolute; inset: 50% 0 auto; border-top: 1px dashed var(--cp-road-stripe); }
.cp-vehicle { position: absolute; left: var(--cp-from); top: var(--cp-lane, 21%); width: 18px; height: 5px; border-radius: 2px; background: var(--cp-vehicle-color, var(--cp-road-marker)); box-shadow: 0 0 9px var(--cp-vehicle-color, var(--cp-road-marker)); animation: cp-drive var(--cp-trip) linear 3; animation-delay: var(--cp-delay, 0s); }
.cp-vehicle::after { content: """"; position: absolute; top: 1px; right: 2px; width: 3px; height: 3px; background: var(--cp-road-headl" &
    "ight); border-radius: 1px; }
.cp-vehicle-a { --cp-from: 11%; --cp-to: 97%; --cp-trip: 8s; }
.cp-vehicle-b { --cp-from: 83%; --cp-to: 3%; --cp-trip: 10s; --cp-lane: 67%; --cp-delay: -.8s; --cp-vehicle-color: var(--cp-road-marker-alt); }
.cp-vehicle-c { --cp-from: 44%; --cp-to: 98%; --cp-trip: 6s; --cp-delay: -2s; }
@keyframes cp-drive { to { left: var(--cp-to); } }
.cp-road { border-radius: var(--cp-radius); }
@container cp-layout (max-width: 760px) {
