.cp-root *, .cp-root *::before, .cp-root *::after { box-sizing: border-box; }
.cp-root [hidden] { display: none !important; }
.cp-root h1, .cp-root h2, .cp-root p { margin: 0; }
.cp-top, .cp-layout, .cp-road, .cp-foot { inline-size: 100%; max-width: var(--cp-wrap); margin-inline: auto; }
.cp-top { display: flex; flex-wrap: wrap; gap: var(--cp-s2); justify-content: space-between; align-items: center; border-bottom: 1px solid var(--cp-border); padding-bottom: var(--cp-s3); }
.cp-brand { display: flex; align-items: center; gap: var(--cp-s2); font-size: 1rem; letter-spacing: .035em; }
.cp-brand i { width: 9px; height: 9px; border-radius: 2px; background: var(--cp-accent); transform: rotate(45deg); }
.cp-top p { color: var(--cp-muted); font-size: .85rem; }
.cp-layout { display: grid; grid-template-columns: minmax(0, 1.42fr) minmax(0, 1fr); gap: var(--cp-s5); align-items: center; padding-block: clamp(v" &
    "ar(--cp-s4), 6vw, 84px); }
.cp-intro { min-width: 0; }
.cp-intro h1 { position: relative; max-width: 14ch; font-size: clamp(2.65rem, 5.55vw, 5.7rem); line-height: .99; letter-spacing: -.065em; font-weight: 740; overflow-wrap: break-word; }
.cp-phrase { opacity: 0; }
