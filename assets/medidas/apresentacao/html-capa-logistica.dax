.cp-intro h1 { max-width:14ch; text-wrap:balance; }
.cp-intro p { max-width:42ch; }
.cp-summary { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:var(--cp-s2);
  margin-top:var(--cp-s3); padding-top:var(--cp-s3); border-top:1px solid var(--cp-border); }
