      };
      toggle.addEventListener('click', () => list.hidden ? open() : close(true));
      toggle.addEventListener('keydown', event => {
        if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
          event.preventDefault();
          open(event.key === 'ArrowUp');
        }
      });
      list.addEventListener('keydown', event => {
        const options = [...list.children];
        const index = options.indexOf(event.target);
        const next = {
          ArrowDown: Math.min(options.length - 1, index + 1),
          ArrowUp: Math.max(0, index - 1),
          Home: 0,
          End: options.length - 1
        }[event.key];
        if (next !== undefined) {
          event.preventDefault();
          options[next]?.focus();
        } else if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          event.target.click();
        }
      });
      picker.addEventListener('pointerdown', event => event.stopPropagation());
      picker.addEv" &
    "entListener('keydown', event => {
        if (event.key === 'Escape' && !list.hidden) {
          event.preventDefault();
          event.stopPropagation();
          close(true);
        }
      });
      picker.addEventListener('focusout', event => {
        if (!picker.contains(event.relatedTarget)) close();
      });
      select.addEventListener('change', refresh);
      refreshers.push(refresh);
      refresh();
    }
    root.addEventListener('pointerdown', () => closeActive?.());
    return () => refreshers.forEach(refresh => refresh());
  }

    const chart = find('chart');
    let chartData = [], chartMedian = null, contextOtif = null, chartWidth = 0;
    const chartMode = find('chart-mode');
    chartMode.value = memory.strategyChart || 'otif';
    chartMode.addEventListener('change', () => {
      memory.strategyChart = chartMode.value;
      closeTooltip();
      renderChart(true);
    });
    const refreshPickers = mountPickers(root);
    function monthDetails(row) {
      const lines = describe({ ...row, label: monthLabel(row.label) + (monthIsPartial(data.meta, row.label) ? ' · período parcial' : '') });
      if (row.otif == null || contextOtif == null) return lines;
      const delta = row.otif - contextOtif;
      const relation = Math.abs(delta) < 1e-10 ? 'em linha com' : delta > 0 ? 'acima de' : 'abaixo de';
      return lines + '\nOTIF ' + relation + ' ' + fmt(contextOtif, percent) + ' no recorte';
    }
    const svgNode = (tag, attrs = {}, label) => {
      const node = document.createElementNS('http://www.w3.org/2000/svg', tag);
      for (const [key, value] of Object.entries(attrs)) node.setAttribute(key, value);
      if (label != null) node.textContent = label;
      return node;
    };
    function renderChart(animate = false) {
      if (!chartData.length || content.hidden) {
        chart.replaceChildren();
        return;
      }
      const width = Math.max(1, Math.floor(chart.clientWidth));
      chartWidth = width;
      const cost " &
    "= chartMode.value === 'unitCost';
      const metric = cost ? 'unitCost' : 'otif';
      const format = cost ? currency : percent;
      find('chart-caption').textContent = cost ? 'Custo logístico médio por pedido, em reais' :
        'Pedidos no prazo e completos entre os elegíveis';
      const history = find('median');
      history.hidden = cost || chartMedian == null;
      history.textContent = history.hidden ? '' : 'Mediana mensal do recorte ' + fmt(chartMedian, percent);
      const height = 266, left = 66, right = 22, top = 21, bottom = 38;
      const plotWidth = Math.max(1, width - left - right), plotHeight = height - top - bottom, yBottom = height - bottom;
      const maximum = cost ? Math.max(20, Math.ceil(Math.max(...chartData.map(row => row.unitCost ?? 0)) / 20) * 20) : 1;
      const step = plotWidth / chartData.length;
      const svg = svgNode('svg', { class: 'ld-svg' + (animate ? ' ld-enter' : ''),
        viewBox: '0 0 ' + width + ' ' + height, role: 'group',
        'aria-label': cost ? 'Custo por pedido por mês. Use Tab para consultar.' : 'OTIF por mês. Use Tab para consultar.' });
      for (let index = 0; index <= 4; index++) {
        const y = yBottom - plotHeight * index / 4;
        svg.append(svgNode('line', { x1: left, x2: width - right, y1: y, y2: y, class: 'ld-gridline' }),
          svgNode('text', { x: left - 5, y: y + 4, class: 'ld-axis', 'text-anchor': 'end' },
            cost ? 'R$ ' + number.format(maximum * index / 4) : index * 25 + '%'));
      }
      if (!cost && chartMedian != null) {
        const y = yBottom - plotHeight * chartMedian;
        svg.append(svgNode('line', { x1: left, x2: width - right, y1: y, y2: y,
          class: 'ld-median-line', 'data-median-value': chartMedian }));
      }
      const path = [], dots = [], hits = [], every = Math.ceil(54 / step);
      let connected = false;
      chartData.forEach((row, index) => {
        const x = left + step * (index + .5), partial = monthIsPartial(data.meta, ro" &
    "w.label);
        if (index % every === 0 || index === chartData.length - 1 && index % every > every / 2) {
          svg.append(svgNode('text', { x, y: yBottom + 21, class: 'ld-axis' + (partial ? ' ld-axis-partial' : ''), 'text-anchor': 'middle' },
            compactMonth(row.label) + (partial ? '*' : '')));
        }
        if (row[metric] != null) {
          const y = yBottom - plotHeight * row[metric] / maximum;
          path.push((connected ? 'L' : 'M') + x + ' ' + y);
          dots.push(svgNode('circle', { cx: x, cy: y, r: 4, class: 'ld-otif-dot' }));
          connected = true;
        } else connected = false;
        const hit = svgNode('rect', { x: left + step * index, y: top, width: step, height: plotHeight, class: 'ld-hit' });
        bindDetails(hit, monthLabel(row.label) + (partial ? ' · mês parcial' : '') + '\n' +
          (cost ? 'Custo por pedido ' + fmt(row.unitCost, format) : 'OTIF ' + fmt(row.otif, format) +
            ' · ' + fmt(row.q) + ' de ' + fmt(row.pe) + ' elegíveis') + '\n' + fmt(row.p) + ' pedidos');
        hits.push(hit);
      });
      svg.append(svgNode('path', { d: path.join(' '), class: 'ld-otif-line', pathLength: 100 }), ...dots, ...hits);
      chart.replaceChildren(svg);
    }
    if (typeof ResizeObserver === 'function') {
      const observer = new ResizeObserver(() => {
        if (!root.isConnected) return observer.disconnect();
        fitFilters();
        if (chart.clientWidth !== chartWidth) {
          closeTooltip();
          renderChart();
        }
      });
      observer.observe(chart);
      observer.observe(root);
    }

    const sparklineSequence = memory.sparklineSequence = (memory.sparklineSequence || 0) + 1;
    function renderSparkline(months, metric, label, formatter, unit) {
      const frame = add('div', 'ld-spark');
      const observed = months.map((row, index) => ({ index, value: row[metric] }))
        .filter(point => Number.isFinite(point.value));
      if (!observed.length) {
        fra" &
    "me.setAttribute('aria-hidden', 'true');
        return frame;
      }
      const min = Math.min(...observed.map(point => point.value));
      const max = Math.max(...observed.map(point => point.value));
      const points = observed.map(point => ({
        index: point.index,
        x: months.length === 1 ? 80 : 4 + 152 * point.index / (months.length - 1),
        y: max === min ? 13 : 21 - 16 * (point.value - min) / (max - min)
      }));
      const runs = [];
      for (const point of points) {
        const current = runs.at(-1);
        if (current && point.index === current.at(-1).index + 1) current.push(point);
        else runs.push([point]);
      }
      const paths = runs.filter(run => run.length > 1).map(run => {
        let path = 'M ' + run[0].x + ' ' + run[0].y;
        for (let i = 1; i < run.length; i++) {
          const a = run[i-1], b = run[i];
          const bend = (b.x - a.x) * .40;
          path += ' C ' + (a.x + bend) + ' ' + a.y + ' ' + (b.x - bend) + ' ' + b.y + ' ' + b.x + ' ' + b.y;
        }
        return { line: path, area: path + ' L ' + run.at(-1).x + ' 26 L ' + run[0].x + ' 26 Z' };
      });
      const svg = svgNode('svg', { viewBox: '0 0 160 26', preserveAspectRatio: 'none', 'aria-hidden': 'true' });
      const id = 'ld-spark-' + sparklineSequence + '-' + metric;
      if (paths.length) {
        const gradient = svgNode('linearGradient', { id, x1: '0%', x2: '0%', y1: '0%', y2: '100%' });
        gradient.append(svgNode('stop', { offset: '0%', class: 'ld-spark-stop' }),
          svgNode('stop', { offset: '100%', class: 'ld-spark-stop', 'stop-opacity': '0' }));
        const defs = svgNode('defs');
        defs.append(gradient);
        svg.append(defs);
        for (const path of paths) svg.append(svgNode('path', { d: path.area, fill: 'url(#' + id + ')' }));
        for (const path of paths) svg.append(svgNode('path', { d: path.line, class: 'ld-spark-line' }));
      }
      const last = points.at(-1);
      const latestPar" &
    "tial = monthIsPartial(data.meta, months[last.index].label);
      const dot = add('span', 'ld-spark-dot' + (latestPartial ? ' ld-partial' : ''));
      dot.style.left = 100 * last.x / 160 + '%';
      dot.style.top = 100 * last.y / 26 + '%';
      dot.setAttribute('aria-hidden', 'true');
      const period = months.length === 1 ? monthLabel(months[0].label) :
        monthLabel(months[0].label) + ' a ' + monthLabel(months.at(-1).label);
      frame.setAttribute('role', 'img');
      frame.setAttribute('aria-label', label + ', tendência de ' + period + '. Último valor: ' +
        fmt(observed.at(-1).value, formatter, unit) + (latestPartial ? ' (período parcial).' : '.'));
      frame.append(svg, dot);
      return frame;
    }

    function renderCards(total, latest, previous, reference, previousKey, months, windowMatch) {
      const specs = [
        ['p', 'Pedidos', number, '', fmt(total.en) + ' com entrega registrada · ' + fmt(ratio(total.en, total.p), percent) + ' do total'],
        ['otif', 'OTIF', percent, '', fmt(total.q) + ' de ' + fmt(total.pe) + ' elegíveis'],
        ['unitCost', 'Custo por pedido', currency, '', fmt(total.cp, currency) + ' de custo total'],
        ['lead', 'Lead time médio', decimal, ' dias', fmt(total.ln) + ' entregas com lead time']
      ];
      const sparkMonths = months.slice(-12);
      find('kpis').replaceChildren(...specs.map(([key, label, format, unit, detail]) => {
        const card = add('article', 'ld-card');
        card.dataset.metric = key;
        if (key === 'otif') card.dataset.primary = '';
        const value = add('strong', 'ld-value', fmt(total[key], format, unit));
        value.dataset.value = total[key] ?? '';
        const delta = add('p', 'ld-delta');
        if (latest?.[key] != null && previous?.[key] != null) {
          const difference = latest[key] - previous[key];
          const sign = difference > 0 ? '+' : '';
          const percentage = ratio(difference, previous[key]);
          const relative" &
    " = percentage == null ? '' : sign + percent.format(percentage);
          const points = key === 'otif' ? sign + decimal.format(difference * 100) + ' p.p.' : '';
          const change = key === 'otif' ? points : relative;
          const compareLabel = 'vs. mês anterior';
          const comparisonPeriod = compactMonth(reference) + ' vs. ' + compactMonth(previousKey) +
            (windowMatch.partial && windowMatch.label ? ' · ' + windowMatch.label : '');
          const improved = key === 'otif' ? difference > 0 : key === 'lead' ? difference < 0 : null;
          if (Math.abs(difference) > 1e-10 && improved !== null) delta.dataset.meaning = improved ? 'better' : 'worse';
          if (change) {
            const arrow = add('span', '', difference > 1e-10 ? '▲' : difference < -1e-10 ? '▼' : '•');
            arrow.setAttribute('aria-hidden', 'true');
            delta.append(arrow, add('strong', '', change), add('span', '', compareLabel));
            bindDetails(delta, label + ' · ' + comparisonPeriod + '\n' + change +
              (key === 'otif' ? ' · ' + fmt(latest.pe) + ' vs ' + fmt(previous.pe) + ' elegíveis' : '') +
              '\n' + fmt(latest[key], format, unit) + ' vs ' + fmt(previous[key], format, unit));
          } else delta.textContent = 'Sem variação percentual';
        } else delta.textContent = 'Sem mês anterior';
        card.append(add('span', 'ld-kpi-label', label), value, add('p', 'ld-kpi-detail', detail),
          renderSparkline(sparkMonths, key, label, format, unit), delta);
        return card;
      }));
    }

    const sort = memory.sort ??= { key: 'label', direction: 'ascending' };
    const sortButtons = [...root.querySelectorAll('[data-sort]')];
    const extraKeys = new Set(['pe', 'misses', 'cp', 'co']);
    const tableMore = find('table-more');
    let tableRows = [];
    tableMore.addEventListener('click', () => {
      memory.tableDetails = !memory.tableDetails;
      renderTable();
    });
    for (const button of sortBut" &
    "tons) {
      button.addEventListener('click', () => {
        const key = button.dataset.sort;
        sort.direction = sort.key === key ?
          (sort.direction === 'ascending' ? 'descending' : 'ascending') :
          (key === 'label' ? 'ascending' : 'descending');
        sort.key = key;
        renderTable();
      });
    }
    function renderTable() {
      const expanded = Boolean(memory.tableDetails);
      if (!expanded && extraKeys.has(sort.key)) {
        sort.key = 'label';
        sort.direction = 'ascending';
      }
      tableMore.setAttribute('aria-expanded', String(expanded));
      tableMore.textContent = expanded ? 'Menos colunas' : 'Mais colunas';
      for (const button of sortButtons) {
        const heading = button.closest('th');
        heading.hidden = !expanded && extraKeys.has(button.dataset.sort);
        const isActive = button.dataset.sort === sort.key;
        if (isActive) heading.setAttribute('aria-sort', sort.direction);
        else heading.removeAttribute('aria-sort');
        button.querySelector('span').textContent = isActive ? (sort.direction === 'ascending' ? '↑' : '↓') : '↕';
      }
      const direction = sort.direction === 'ascending' ? 1 : -1;
      const sorted = [...tableRows].sort((a, b) => {
        const x = a[sort.key], y = b[sort.key];
        if (x == null || y == null) return Number(x == null) - Number(y == null) || collator.compare(a.label, b.label);
        const order = sort.key === 'label' ? collator.compare(x, y) : x - y;
        return direction * order || collator.compare(a.label, b.label);
      });
      find('table').replaceChildren(...sorted.map((row, index) => {
        const el = add('tr'), heading = add('th');
        heading.scope = 'row';
        const rank = add('span', 'ld-table-rank', '#' + (index + 1));
        rank.setAttribute('aria-label', 'Posição ' + (index + 1));
        heading.append(rank, add('span', 'ld-carrier-name', row.label));
        el.dataset.sortValue = row[sort.key] ??" &
    " '';
        el.append(heading, add('td', '', fmt(row.p)));
        const rate = add('span', 'ld-table-rate');
        if (row.otif == null) rate.textContent = '—';
        else {
          const difference = contextOtif == null ? 0 : row.otif - contextOtif;
          const relative = difference > 1e-10 ? 'above' : difference < -1e-10 ? 'below' : 'equal';
          rate.dataset.reference = relative;
          const mark = add('span', '', relative === 'above' ? '▲' : relative === 'below' ? '▼' : '•');
          mark.setAttribute('aria-hidden', 'true');
          rate.append(mark, add('span', '', fmt(row.otif, percent)));
          bindDetails(rate, row.label + ' · OTIF ' + fmt(row.otif, percent) + '\n' +
            fmt(row.q) + ' de ' + fmt(row.pe) + ' pedidos elegíveis\n' +
            (relative === 'above' ? 'Acima do' : relative === 'below' ? 'Abaixo do' : 'Igual ao') +
            ' OTIF do recorte (' + fmt(contextOtif, percent) + ')');
        }
        const otifCell = add('td');
        otifCell.append(rate);
        el.append(otifCell, add('td', '', fmt(row.lead, decimal, ' dias')),
          add('td', '', fmt(row.unitCost, currency)));
        for (const value of [fmt(row.pe), fmt(row.misses), fmt(row.cp, currency), fmt(row.co, decimal, ' kg')]) {
          const cell = add('td', '', value);
          cell.hidden = !expanded;
          el.append(cell);
        }
        return el;
      }));
    }

    function render() {
      refreshPickers();
      closeTooltip();
      const filters = fields.filter(([key]) => selected[key]);
      const matches = (row, constraints) => constraints.every(([key]) => row[key] === selected[key]);
      const rows = base.filter(row => matches(row, filters));
      const months = group(rows, 'm').sort((a, b) => collator.compare(a.label, b.label));
      const period = months.length < 2 ? monthLabel(months[0]?.label) :
        monthLabel(months[0].label) + ' a ' + monthLabel(months.at(-1).label);
      find('period').textConten" &
    "t = rows.length ?
        period + ' · por data do pedido' + (data.meta.dataFinal ? ' · recorte Power BI até ' + data.meta.dataFinal.split('-').reverse().join('/') : '') :
        'Sem pedidos no recorte';
      find('clear').disabled = !filters.length;
      find('filter-summary').textContent = filters.length ? '· ' + filters.length + ' ativos' : '· todos';
      stateText.hidden = Boolean(rows.length);
      content.hidden = !rows.length;
      if (!rows.length) {
        stateText.textContent = base.length ?
          'Nenhum pedido corresponde à combinação selecionada. Ajuste ou limpe os filtros internos.' :
          'Nenhum pedido no recorte atual do Power BI.';
        chartData = [];
        for (const name of ['kpis', 'chart', 'insights', 'table', 'priority', 'period-note']) find(name).replaceChildren();
        return;
      }
      const total = tally(rows);
      const latest = months.at(-1);
      const priorKey = previousMonth(latest.label);
      const windowMatch = compareCalendar(data.meta, latest.label, priorKey);
      const dayMatches = row => !windowMatch.days || windowMatch.days.has(row.d);
      const priorPool = comparison.some(row => row.m === priorKey) ? comparison : base;
      const priorRows = priorPool.filter(row => row.m === priorKey && dayMatches(row) && matches(row, filters.filter(([key]) => key !== 'm')));
      const latestRows = windowMatch.partial ? rows.filter(row => row.m === latest.label && dayMatches(row)) : null;
      const latestComparable = !latestRows ? latest : latestRows.length ? tally(latestRows) : null;
      const prior = priorRows.length ? tally(priorRows) : null;
      const carriers = group(rows, 't'), regions = group(rows, 'r');
      const comparableRegions = regions.filter(row => row.pe > 0);
      const lowestRegion = comparableRegions.length > 1 ? ascendingOtif(comparableRegions).find(row => row.misses > 0) : null;
      const impactRegion = descending(regions, 'misses')[0];
      const serviceHeadline = tot" &
    "al.pe ? 'OTIF de ' + fmt(total.otif, percent) + ' no recorte. ' : 'Sem pedidos elegíveis para OTIF. ';
      const focusHeadline = impactRegion?.misses ? (comparableRegions.length > 1 ?
        'Investigue ' + impactRegion.label + ': ' + fmt(impactRegion.misses) + ' das ' + fmt(total.misses) + ' falhas de OTIF.' :
        fmt(total.misses) + ' falhas de OTIF entre ' + fmt(total.pe) + ' elegíveis.') :
        total.pe ? 'Nenhuma falha entre ' + fmt(total.pe) + ' elegíveis.' : '';
      find('priority').replaceChildren(add('strong', '', serviceHeadline), document.createTextNode(focusHeadline));
      const anyPartial = months.some(row=>monthIsPartial(data.meta,row.label));
      find('period-note').textContent = 'Cards resumem o recorte. ' + (prior ?
        'Comparação mensal: ' + compactMonth(latest.label) + ' vs. ' + compactMonth(priorKey) +
        (windowMatch.partial && windowMatch.label ? ' · ' + windowMatch.label + '.' : '.') : 'Sem comparação mensal no recorte.') +
        (anyPartial ? ' * Mês parcial.' : '');
      renderCards(total, latestComparable, prior, latest.label, priorKey, months, windowMatch);
      const insights = [];
      if (impactRegion?.misses) {
        const isAlsoLowest = lowestRegion?.label === impactRegion.label;
        const heading = comparableRegions.length === 1 ? 'Falhas no recorte · ' + impactRegion.label :
          (isAlsoLowest ? 'Maior impacto e menor OTIF · ' : 'Maior impacto · ') + impactRegion.label;
        const volume = comparableRegions.length > 1 ? fmt(impactRegion.misses) + ' das ' + fmt(total.misses) + ' falhas do recorte.' :
          fmt(impactRegion.misses) + ' falhas em ' + fmt(impactRegion.pe) + ' elegíveis.';
        insights.push([heading, volume + (isAlsoLowest ? ' OTIF de ' + fmt(impactRegion.otif, percent) + '.' : '') +
          ' Revise as ocorrências para identificar ações.']);
      }
      if (lowestRegion && lowestRegion.label !== impactRegion?.label) insights.push(['Menor OTIF · ' + lowestRegion.la" &
    "bel,
        fmt(lowestRegion.otif, percent) + ' de OTIF, com ' + fmt(lowestRegion.misses) +
        ' falhas em ' + fmt(lowestRegion.pe) + ' elegíveis. Investigue a recorrência das falhas.']);
      if (!insights.length) insights.push(['Nível de serviço', total.pe ?
        'Nenhuma falha entre os pedidos elegíveis do recorte.' : 'Sem pedidos elegíveis para comparar o OTIF.']);
      find('insights').replaceChildren(...insights.map(([label, text]) => {
        const block = add('div', 'ld-insight');
        block.append(add('strong', '', label), add('p', '', text));
        return block;
      }));
      chartData = months;
      chartMedian = median(months.map(row => row.otif));
      contextOtif = total.otif;
      renderChart(true);
      tableRows = carriers;
      renderTable();
    }
    render();
  } catch (error) {
    stateText.textContent = 'Não foi possível carregar o painel. Verifique a medida Gold e o suporte a scripts do visual.';
    stateText.hidden = false;
    content.hidden = true;
    console.error('Logistics Analytics', error);
  }
})();
</script>
</div>
"
