HTML Dashboard Logistica =
VAR Gold = [JSON Gold Dashboard Logistica]
VAR Payload = SUBSTITUTE(Gold, "<", "\u003c")
RETURN
    "<style>.ld-root {
  --ld-font: ""Inter"", ""Segoe UI"", sans-serif;
  --ld-bg: #edf2f6; --ld-surface: #fff; --ld-soft: #f5f8fb; --ld-border: #d8e1e9;
  --ld-text: #142638; --ld-muted: #4c6175; --ld-head: #112c42; --ld-on-head: #f3f9ff; --ld-on-head-muted: #bbd1e2;
  --ld-accent: #007a6e; --ld-on-accent: #fff; --ld-accent-soft: #e3f4ee;
  --ld-bar: #568cb5; --ld-cost: #326697; --ld-line: #00776a; --ld-median: #735487; --ld-risk: #a34927;
  --ld-spark: #14586b; --ld-spark-wash: #14586b24;
  --ld-growth: #076847; --ld-growth-bg: #e6f5ec; --ld-drop: #a1283d; --ld-drop-bg: #fff0f2;
  --ld-road-size: 24px; --ld-road-edge: #44687f; --ld-road-bed: #0b2335; --ld-road-stripe: #638093;
  --ld-road-marker: #6ce7cb; --ld-road-marker-alt: #88c8fa; --ld-road-headlight: #f4ffff;
  --ld-tooltip-bg: #123047; --ld-tooltip-fg: #fff; --ld-focus: #007a6e;
  --ld-s1: 4px; --ld-s2: 8px; --ld-s3: 12px; --ld-s4: 16px; --ld-s5: 20px; --ld-s6: 24px; --ld-s7: 32px;
  --ld-r1: 8px; --ld-r2: 14px; --ld-text-xs: .9rem; --ld-text-sm: .98rem; --ld-text-md: 1rem;
  --ld-num: clamp(1.08rem, 2vw, 1.77rem); --ld-title: clamp(1.65rem, 3vw, 2.65rem);
  display: block; position: relative; container: ld-layout / inline-size;
  background: var(--ld-bg); color: var(--ld-text); font: 400 1rem/1.42 var(--ld-font);
  box-sizing: border-box; padding: clamp(10px, 2vw, 24px); color-scheme: light; text-align: left;
}
.ld-root[data-theme=""dark""] {
  --ld-bg: #09131e; --ld-surface: #10202e; --ld-soft: #142737; --ld-border: #2c4256;
  --ld-text: #e7f2fa; --ld-muted: #a5bacb; --ld-head: #102838; --ld-on-head: #f3f9ff; --ld-on-head-muted: #aac7d7;
  --ld-accent: #66ead0; --ld-on-accent: #0b2630; --ld-accent-soft: #173936;
  --ld-bar: #6f9fca; --ld-cost: #85b7e1; --ld-line: #66ead0; --ld-median: #c6a7df; --ld-risk: #f5a486;
  --ld-spark: #75bfd0; --ld-spark-wash: #75bfd026;
  --ld-growth: #7fe8b4; --ld-growth-bg: #18382e; --ld-drop: #ffabb7; --ld-drop-bg: #40252e;
  --ld-tooltip-bg: #e7f2fa; --ld-tooltip-fg: #122731; --ld-foc" &
    "us: #66ead0;
  color-scheme: dark;
}
.ld-root *, .ld-root *::before, .ld-root *::after { box-sizing: border-box; }
.ld-root [hidden] { display: none !important; }
.ld-root :focus-visible { outline: 2px solid var(--ld-focus); outline-offset: 2px; }
.ld-root h1, .ld-root h2, .ld-root p { margin: 0; }
.ld-header {
  min-width: 0; display: flex; justify-content: space-between; align-items: center; gap: var(--ld-s4); flex-wrap: wrap;
  background: var(--ld-head); color: var(--ld-on-head); border-radius: var(--ld-r2); padding: var(--ld-s5) var(--ld-s6);
}
.ld-header h1 { font-size: var(--ld-title); line-height: 1.08; font-weight: 730; letter-spacing: -.04em; }
.ld-header .ld-period { color: var(--ld-on-head-muted); margin-top: var(--ld-s2); font-size: var(--ld-text-sm); }
.ld-header-right { display: grid; justify-items: end; gap: var(--ld-s2); }
.ld-source { display: grid; text-align: right; color: var(--ld-on-head-muted); font-size: var(--ld-text-xs); overflow-wrap: anywhere; }
.ld-button { cursor: pointer; font: 600 var(--ld-text-sm) var(--ld-font); padding: var(--ld-s2) var(--ld-s3); border: 1px solid var(--ld-border); border-radius: var(--ld-r1); color: var(--ld-text); background: var(--ld-surface); min-height: 36px; }
.ld-button:hover { background: var(--ld-soft); }
.ld-button:disabled { opacity: .62; cursor: default; }
.ld-theme { color: var(--ld-on-head); border-color: var(--ld-on-head-muted); background: var(--ld-head); }
.ld-theme:hover { color: var(--ld-on-accent); background: var(--ld-accent); border-color: var(--ld-accent); }
.ld-controls { margin: var(--ld-s3) 0; padding: var(--ld-s3) var(--ld-s4); background: var(--ld-surface); border: 1px solid var(--ld-border); border-radius: var(--ld-r2); display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--ld-s2); min-width: 0; }
.ld-fields { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: var(--ld-s3); flex: 1 1 650px; min-width: 0; }
.ld-field { min-width: 0; display: grid; gap: var(--" &
    "ld-s1); font-weight: 620; font-size: var(--ld-text-xs); color: var(--ld-muted); }
.ld-field select { width: 100%; min-width: 0; font: 500 var(--ld-text-sm) var(--ld-font); border: 1px solid var(--ld-border); border-radius: var(--ld-r1); padding: var(--ld-s2); min-height: 36px; color: var(--ld-text); background: var(--ld-soft); }
  .ld-filter-bar { display:grid; grid-template-columns:minmax(0,1fr) max-content; align-items:end; gap:var(--ld-s3); min-width:0; }
  .ld-filter-bar > .ld-fields { align-items:end; }
  .ld-filter-bar > .ld-clear { min-block-size:40px; white-space:nowrap; max-inline-size:100%; }
  @container ld-layout (max-width:560px) {
    .ld-filter-bar { grid-template-columns:minmax(0,1fr); gap:var(--ld-s2); }
    .ld-filter-bar > .ld-clear { justify-self:end; }
  }
.ld-state { padding: var(--ld-s7) var(--ld-s4); border: 1px solid var(--ld-border); border-radius: var(--ld-r2); background: var(--ld-surface); color: var(--ld-muted); }
.ld-content { display: grid; gap: var(--ld-s3); min-width: 0; }
.ld-ticker { display: flex; flex-wrap: wrap; align-items: center; gap: var(--ld-s2) var(--ld-s4); padding: var(--ld-s2) var(--ld-s4); color: var(--ld-muted); background: var(--ld-soft); border: 1px solid var(--ld-border); border-radius: var(--ld-r1); font-size: var(--ld-text-xs); }
.ld-ticker strong { color: var(--ld-accent); white-space: nowrap; }
.ld-ticker div { display: flex; flex-wrap: wrap; gap: var(--ld-s2) var(--ld-s4); }
.ld-ticker span { padding-inline-start: var(--ld-s3); border-inline-start: 1px solid var(--ld-border); }
.ld-kpis { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.23fr) minmax(0, 1.25fr) repeat(2, minmax(0, 1fr)); gap: var(--ld-s3); }
.ld-card, .ld-panel { min-width: 0; border: 1px solid var(--ld-border); background: var(--ld-surface); border-radius: var(--ld-r2); }
.ld-card { display: grid; align-content: start; gap: var(--ld-s1); padding: var(--ld-s3) var(--ld-s4); }
.ld-card[data-primary] { background: var(--ld-accent" &
    "-soft); border-top: 3px solid var(--ld-accent); padding-top: calc(var(--ld-s3) - 2px); }
.ld-kpi-label { font-size: var(--ld-text-xs); font-weight: 650; color: var(--ld-muted); }
.ld-value { font-size: var(--ld-num); font-variant-numeric: tabular-nums; font-weight: 740; letter-spacing: -.04em; overflow-wrap: anywhere; line-height: 1.2; }
.ld-kpi-detail { font-size: var(--ld-text-xs); color: var(--ld-muted); }
.ld-delta { font-size: var(--ld-text-xs); color: var(--ld-muted); margin-top: var(--ld-s1); }
.ld-delta[data-direction=""lower""] { color: var(--ld-risk); }
.ld-delta[data-direction=""higher""] { color: var(--ld-accent); }
.ld-overview { display: grid; grid-template-columns: minmax(0, 2.25fr) minmax(0, 1fr); gap: var(--ld-s3); }
.ld-breakdown { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--ld-s3); min-width: 0; }
.ld-panel { padding: var(--ld-s4); }
.ld-panel-head { display: flex; justify-content: space-between; align-items: start; flex-wrap: wrap; gap: var(--ld-s2); margin-bottom: var(--ld-s3); }
.ld-panel-head h2 { color: var(--ld-text); font-size: 1.02rem; font-weight: 720; letter-spacing: -.02em; }
.ld-panel-head p { color: var(--ld-muted); font-size: var(--ld-text-xs); margin-top: var(--ld-s1); }
.ld-brief { background: var(--ld-soft); }
.ld-insights { display: grid; gap: var(--ld-s3); }
.ld-insight { border-inline-start: 2px solid var(--ld-border); padding-inline-start: var(--ld-s3); }
.ld-insight:first-child { border-color: var(--ld-accent); }
.ld-insight strong { display: block; font-size: var(--ld-text-sm); margin-bottom: var(--ld-s1); }
.ld-insight p { font-size: var(--ld-text-xs); color: var(--ld-muted); }
.ld-chart { min-width: 0; height: 266px; }
.ld-svg { display: block; width: 100%; height: 100%; overflow: visible; }
.ld-gridline { stroke: var(--ld-border); stroke-width: 1; }
.ld-axis { fill: var(--ld-muted); font: 11px var(--ld-font); }
.ld-bar { fill: var(--ld-bar); }
.ld-otif-line { stroke: var(--ld-line); stroke-widt" &
    "h: 2.5; fill: none; stroke-linecap: round; stroke-linejoin: round; }
.ld-otif-dot { fill: var(--ld-line); stroke: var(--ld-surface); stroke-width: 1.5; }
.ld-hit { fill: transparent; cursor: help; }
.ld-hit:hover, .ld-hit:focus { fill: var(--ld-line); fill-opacity: .08; stroke: var(--ld-focus); stroke-opacity: .55; outline: none !important; }
.ld-legend { display: flex; flex-wrap: wrap; gap: var(--ld-s3); font-size: var(--ld-text-xs); color: var(--ld-muted); }
.ld-legend span { display: inline-flex; gap: var(--ld-s1); align-items: center; }
.ld-legend span::before { content: """"; display: inline-block; background: var(--ld-bar); width: var(--ld-s3); height: var(--ld-s2); border-radius: 2px; }
.ld-legend .ld-key-otif::before { background: var(--ld-line); height: 3px; }
.ld-ranking { display: grid; gap: var(--ld-s3); }
.ld-rank-row { display: grid; gap: var(--ld-s1); cursor: help; min-width: 0; }
.ld-rank-label { display: flex; justify-content: space-between; align-items: start; gap: var(--ld-s2); font-size: var(--ld-text-xs); }
.ld-rank-label span:first-child { overflow-wrap: anywhere; }
.ld-rank-label strong { white-space: nowrap; font-variant-numeric: tabular-nums; }
.ld-track { height: 5px; display: block; border-radius: var(--ld-r1); background: var(--ld-border); }
.ld-fill { height: 100%; display: block; border-radius: inherit; background: var(--ld-line); }
.ld-fill.ld-cost { background: var(--ld-cost); }
.ld-fill.ld-risk { background: var(--ld-risk); }
.ld-rank-sub { color: var(--ld-muted); font-size: var(--ld-text-xs); }
.ld-table-wrap { overflow-x: auto; max-width: 100%; }
.ld-table { width: 100%; border-collapse: collapse; font-size: var(--ld-text-xs); font-variant-numeric: tabular-nums; }
.ld-table th, .ld-table td { text-align: right; white-space: nowrap; padding: var(--ld-s2) var(--ld-s3); border-bottom: 1px solid var(--ld-border); }
.ld-table th { background: var(--ld-soft); color: var(--ld-muted); }
.ld-table th:first-child { text-align: left; }
.ld-tabl" &
    "e tbody th { background: none; color: var(--ld-text); font-weight: 630; }
.ld-tooltip { position: absolute; z-index: 4; max-width: min(290px, calc(100% - 24px)); pointer-events: none; padding: var(--ld-s2) var(--ld-s3); border-radius: var(--ld-r1); background: var(--ld-tooltip-bg); color: var(--ld-tooltip-fg); white-space: pre-line; overflow-wrap: anywhere; font-size: var(--ld-text-xs); }
@container ld-layout (max-width: 920px) {
  .ld-overview { grid-template-columns: minmax(0, 1.75fr) minmax(0, 1fr); }
  .ld-kpis { grid-template-columns: repeat(3, minmax(0, 1fr)); }
}
@container ld-layout (max-width: 685px) {
  .ld-fields { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .ld-overview, .ld-breakdown { grid-template-columns: minmax(0, 1fr); }
  .ld-header { padding: var(--ld-s4); }
  .ld-header-right { justify-items: start; }
  .ld-source { text-align: left; }
}
@container ld-layout (max-width: 385px) {
  .ld-kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .ld-panel { padding: var(--ld-s3); }
}
.ld-median-line { stroke: var(--ld-median); stroke-width: 1.5; stroke-dasharray: 5 4; }
.ld-legend .ld-key-median::before { background: transparent; border-top: 2px dashed var(--ld-median); height: 0; border-radius: 0; }
.ld-axis-title { font-weight: 680; }
.ld-mode-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 225px), 1fr)); gap: var(--ld-s3); }
.ld-mode { display: grid; gap: var(--ld-s2); background: var(--ld-soft); border: 1px solid var(--ld-border); border-radius: var(--ld-r1); padding: var(--ld-s3); cursor: help; }
.ld-mode .ld-mode-label { font-size: var(--ld-text-sm); }
.ld-mode dl { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--ld-s2); margin: 0; font-size: var(--ld-text-xs); }
.ld-mode dt, .ld-mode p, .ld-rank-empty { color: var(--ld-muted); font-size: var(--ld-text-xs); }
.ld-mode dd { margin: 0; font-weight: 650; font-variant-numeric: tabular-nums; }
.ld-classification { padding: var(" &
    "--ld-s1) var(--ld-s2); background: var(--ld-soft); border: 1px solid var(--ld-border); border-radius: var(--ld-r1); }
.ld-table th button { background: transparent; border: 0; color: inherit; cursor: pointer; font: inherit; font-weight: 650; padding: 0; }
.ld-table th button span { margin-inline-start: var(--ld-s1); color: var(--ld-muted); }
.ld-table th[aria-sort] button, .ld-table th[aria-sort] button span { color: var(--ld-accent); }

.ld-road { position: relative; isolation: isolate; overflow: hidden; block-size: var(--ld-road-size); border-block: 1px solid var(--ld-road-edge); background: var(--ld-road-bed); pointer-events: none; }
.ld-road::before { content: """"; position: absolute; inset: 50% 0 auto; border-top: 1px dashed var(--ld-road-stripe); }
.ld-vehicle { position: absolute; left: var(--ld-from); top: var(--ld-lane, 21%); width: 18px; height: 5px; border-radius: 2px; background: var(--ld-vehicle-color, var(--ld-road-marker)); box-shadow: 0 0 9px var(--ld-vehicle-color, var(--ld-road-marker)); animation: ld-drive var(--ld-trip) linear 3; animation-delay: var(--ld-delay, 0s); }
.ld-vehicle::after { content: """"; position: absolute; top: 1px; right: 2px; width: 3px; height: 3px; background: var(--ld-road-headlight); border-radius: 1px; }
.ld-vehicle-a { --ld-from: 11%; --ld-to: 97%; --ld-trip: 8s; }
.ld-vehicle-b { --ld-from: 83%; --ld-to: 3%; --ld-trip: 10s; --ld-lane: 67%; --ld-delay: -.8s; --ld-vehicle-color: var(--ld-road-marker-alt); }
.ld-vehicle-c { --ld-from: 44%; --ld-to: 98%; --ld-trip: 6s; --ld-delay: -2s; }
@keyframes ld-drive { to { left: var(--ld-to); } }
.ld-header .ld-road { flex: 0 0 100%; border-radius: var(--ld-r1); }
.ld-product-ticker { display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: center; gap: var(--ld-s3); border: 1px solid var(--ld-border); border-radius: var(--ld-r1); padding: var(--ld-s2) var(--ld-s4); color: var(--ld-text); background: var(--ld-surface); font-size: var(--ld-text-xs); }
.ld-product-ticker >" &
    " strong { color: var(--ld-accent); }
.ld-product-window { min-width: 0; overflow: hidden; }
.ld-product-track { display: flex; width: max-content; min-width: 200%; animation: ld-product-pass 18s linear 2; }
.ld-product-ticker:hover .ld-product-track, .ld-product-ticker:focus-within .ld-product-track { animation-play-state: paused; }
.ld-product-list { display: flex; flex: 1 0 50%; justify-content: space-around; gap: var(--ld-s3); list-style: none; margin: 0; padding: 0 var(--ld-s3); }
.ld-product-list li { display: inline-flex; align-items: baseline; gap: var(--ld-s2); }
.ld-product-position { color: var(--ld-accent); font-weight: 740; }
.ld-product-qty { font-weight: 650; white-space: nowrap; }
.ld-card { transition: transform 180ms ease, border-color 180ms ease; }
.ld-card:hover { border-color: var(--ld-accent); }

.ld-delta { width: fit-content; padding: var(--ld-s1) var(--ld-s2); border-radius: var(--ld-r1); }
.ld-delta[data-meaning=""better""] { color: var(--ld-growth); background: var(--ld-growth-bg); }
.ld-delta[data-meaning=""worse""] { color: var(--ld-drop); background: var(--ld-drop-bg); animation: ld-delta-pulse 850ms ease-in-out 2; }
.ld-svg.ld-enter .ld-bar { transform-box: fill-box; transform-origin: center bottom; animation: ld-bar-in 590ms ease-out both; }
.ld-svg.ld-enter .ld-otif-line { stroke-dasharray: 100; animation: ld-line-in 690ms ease-out both; }
.ld-svg.ld-enter .ld-otif-dot, .ld-svg.ld-enter .ld-median-line { animation: ld-fade-in 660ms ease-out both; }
.ld-bar.ld-highlight { filter: brightness(1.2); }
@keyframes ld-product-pass { to { transform: translateX(-50%); } }
@keyframes ld-card-in { from { opacity: .65; transform: translateY(4px); } }
@keyframes ld-delta-pulse { 50% { opacity: .76; } }
@keyframes ld-bar-in { from { transform: scaleY(0); } }
@keyframes ld-line-in { from { stroke-dashoffset: 100; } to { stroke-dashoffset: 0; } }
@keyframes ld-fade-in { from { opacity: 0; } }
@container ld-layout (max-width: 685px) {
  .ld-product-ticker" &
    " { grid-template-columns: minmax(0, 1fr); gap: var(--ld-s1); }
  .ld-product-track { width: auto; min-width: 0; animation: none; }
  .ld-product-list { flex: 1; flex-direction: column; gap: var(--ld-s1); padding: 0; }
  .ld-product-list[aria-hidden] { display: none; }
}
@media (prefers-reduced-motion: reduce) {
  .ld-root *, .ld-root *::before, .ld-root *::after { animation: none !important; transition: none !important; }
  .ld-root .ld-card:hover { transform: none; }
}

.ld-card { padding-bottom: calc(var(--ld-s3) - 5px); }
.ld-spark { position: relative; width: 80%; height: 26px; }
.ld-spark svg { display: block; width: 100%; height: 100%; overflow: visible; }
.ld-spark-line { stroke: var(--ld-spark); stroke-width: 1.65; stroke-linecap: round; fill: none; vector-effect: non-scaling-stroke; }
.ld-spark-stop { stop-color: var(--ld-spark-wash); }
.ld-spark-dot { position: absolute; width: 5px; height: 5px; border-radius: 50%; background: var(--ld-spark); transform: translate(-50%, -50%); }

.ld-filter-box { margin: var(--ld-s3) 0; }
.ld-filter-box > summary { display: none; }
.ld-filter-box .ld-controls { margin: 0; }
.ld-priority { background: var(--ld-accent-soft); border-inline-start: 3px solid var(--ld-accent); padding: var(--ld-s2) var(--ld-s3); border-radius: var(--ld-r1); color: var(--ld-text); font-size: var(--ld-text-sm); }
.ld-priority strong { font-weight: 730; }
.ld-period-note { color: var(--ld-muted); font-size: var(--ld-text-xs); }
.ld-product-ticker { grid-template-columns: minmax(0, 1fr); margin-top: var(--ld-s4); gap: var(--ld-s1); }
.ld-bar.ld-partial { fill-opacity: .52; }
.ld-spark-dot.ld-partial { background: var(--ld-surface); border: 1px solid var(--ld-spark); }
@container ld-layout (max-width: 685px) {
  .ld-filter-box { background: var(--ld-surface); border: 1px solid var(--ld-border); border-radius: var(--ld-r1); }
  .ld-filter-box > summary { display: list-item; padding: var(--ld-s2) var(--ld-s3); cursor: pointer; font-size: var(--ld-text-" &
    "sm); font-weight: 650; }
  .ld-filter-box > summary span { color: var(--ld-muted); font-weight: 500; }
  .ld-filter-box .ld-controls { border: 0; }
}

.ld-delta { display: inline-flex; gap: var(--ld-s1); align-items: baseline; width: fit-content; max-width: 100%; padding: 2px 6px; border: 1px solid var(--ld-border); border-radius: 999px; background: var(--ld-soft); line-height: 1.15; font-size: .71rem; }
.ld-delta[data-meaning=""better""] { border-color: color-mix(in srgb, var(--ld-growth) 27%, var(--ld-border)); }
.ld-delta[data-meaning=""worse""] { border-color: color-mix(in srgb, var(--ld-drop) 25%, var(--ld-border)); }
.ld-delta strong, .ld-delta span { white-space: nowrap; }
.ld-table-more { min-height: 30px; font-size: var(--ld-text-xs); }
.ld-table-rank { display: inline-block; min-width: 2.15em; padding: 2px 5px; margin-inline-end: var(--ld-s2); border-radius: 999px; background: var(--ld-accent-soft); color: var(--ld-accent); text-align: center; font-size: .72rem; font-weight: 700; }
.ld-table-rate { display: inline-flex; align-items: center; gap: var(--ld-s1); border-radius: 999px; background: var(--ld-soft); padding: 2px 7px; font-weight: 650; }
.ld-table-rate[data-reference=""above""] { background: var(--ld-growth-bg); color: var(--ld-growth); }
.ld-table-rate[data-reference=""below""] { background: var(--ld-drop-bg); color: var(--ld-drop); }
.ld-table tbody tr:nth-child(even) { background: var(--ld-soft); }
.ld-table tbody tr:hover { background: var(--ld-accent-soft); }
.ld-table thead th { font-size: .73rem; }
@container ld-layout (max-width: 385px) {
  .ld-delta { flex-wrap: wrap; column-gap: 3px; }
}


.ld-fields.ld-fields-primary { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.ld-fields.ld-fields-secondary { grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: var(--ld-s2); }
.ld-extra-filters > summary, .ld-carrier-detail > summary { cursor: pointer; color: var(--ld-accent); font-weight: 650; font-size: var(--ld-text-sm); }
.ld-strategy-kpis" &
    " { grid-template-columns: repeat(4, minmax(0, 1fr)); }
.ld-strategy-legend { min-height: 1em; }
.ld-detail-inner { margin-top: var(--ld-s3); }
.ld-chart .ld-axis-partial { font-weight: 700; }
@container ld-layout (max-width: 685px) {
  .ld-fields.ld-fields-secondary { grid-template-columns: repeat(2, minmax(0,1fr)); }
  .ld-strategy-kpis { grid-template-columns: repeat(2, minmax(0,1fr)); }
}

.ld-picker { position:relative; min-width:0; }
.ld-picker > button { width:100%; min-height:40px; display:flex; align-items:center; justify-content:space-between; gap:10px; text-align:left; padding:7px 10px; color:var(--ld-text); background:var(--ld-soft); border:1px solid var(--ld-border); border-radius:7px; font:600 .91rem/1.3 var(--ld-font); cursor:pointer; overflow-wrap:anywhere; }
.ld-picker > button::after { content:""""; flex:none; width:7px; height:7px; margin-inline-end:3px; border:solid currentColor; border-width:0 2px 2px 0; transform:rotate(45deg) translateY(-2px); }
.ld-picker > button[aria-expanded=""true""] { border-color:var(--ld-accent); }
.ld-picker-list { position:absolute; z-index:15; inset:calc(100% + 4px) 0 auto; margin:0; padding:4px; list-style:none; overflow:auto; overscroll-behavior:contain; color:var(--ld-text); background:var(--ld-surface); border:1px solid var(--ld-border); border-radius:8px; box-shadow:0 6px 16px #0d263029; }
.ld-picker[data-above] > .ld-picker-list { inset:auto 0 calc(100% + 4px); }
.ld-picker-list > li { min-height:34px; display:flex; align-items:center; padding:6px 8px; border-radius:5px; cursor:pointer; font:500 .91rem/1.3 var(--ld-font); overflow-wrap:anywhere; }
.ld-picker-list > [aria-selected=""true""] { font-weight:700; color:var(--ld-accent); background:var(--ld-accent-soft); }
.ld-picker-list > li:hover,.ld-picker-list > li:focus { background:var(--ld-soft); outline:2px solid var(--ld-accent); outline-offset:-2px; }

.ld-value { font-size:clamp(1.45rem, 2.35cqi, 2.15rem); }
.ld-panel-head h2 { font-size:1.17rem; }
.ld-axis { f" &
    "ont-size:13px; }
.ld-delta, .ld-table-rank { font-size:.84rem; }
.ld-table thead th { font-size:.88rem; }
.ld-panel-head .ld-field { min-inline-size:min(182px, 100%); }

</style><div class=""ld-root"" data-theme=""light"" lang=""pt-BR"">
  <header class=""ld-header"" data-hc-suppress=""all"">
    <div>
      <h1>Estratégia logística</h1>
      <p class=""ld-period"" data-period></p>
    </div>
    <div class=""ld-header-right"">
      <button type=""button"" class=""ld-button ld-theme"" data-theme-switch aria-label=""Alternar modo escuro"" aria-pressed=""false"">Modo escuro</button>
      <div class=""ld-source""><span data-source></span><span data-reference></span><time data-rendered></time></div>
    </div>
    <div class=""ld-road"" aria-hidden=""true""><span class=""ld-vehicle ld-vehicle-a""></span><span class=""ld-vehicle ld-vehicle-b""></span><span class=""ld-vehicle ld-vehicle-c""></span></div>
  </header>
  <details class=""ld-filter-box"" data-filter-box open>
    <summary>Filtros internos <span data-filter-summary></span></summary>
    <section class=""ld-controls"" data-hc-suppress=""all"" aria-label=""Filtros internos"">
      <div class=""ld-filter-bar"">
        <div class=""ld-fields ld-fields-primary"" data-fields></div>
        <button type=""button"" class=""ld-button ld-clear"" data-clear disabled>Limpar filtros</button>
      </div>
      <details class=""ld-extra-filters"">
        <summary>Mais filtros</summary>
        <div class=""ld-fields ld-fields-secondary"" data-extra-fields></div>
      </details>
    </section>
  </details>
  <p class=""ld-state"" role=""status"" data-state>Carregando painel interativo…</p>
  <main class=""ld-content"" data-content hidden>
    <aside class=""ld-priority"" aria-label=""Resumo executivo"" data-priority></aside>
    <p class=""ld-period-note"" data-period-note></p>
    <section class=""ld-kpis ld-strategy-kpis"" aria-label=""Indicadores principais"" data-kpis></section>
    <div class=""ld-overview"">
      <section class=""ld-panel"">
        <div class=""ld-panel-head"">
      " &
    "    <div><h2>Tendência mensal</h2><p data-chart-caption></p></div>
          <label class=""ld-field""><span>Indicador</span><select data-chart-mode><option value=""otif"">OTIF</option><option value=""unitCost"">Custo por pedido</option></select></label>
        </div>
        <div class=""ld-legend ld-strategy-legend""><span class=""ld-key-median"" data-median hidden></span></div>
        <div class=""ld-chart"" data-chart></div>
      </section>
      <section class=""ld-panel ld-brief"">
        <div class=""ld-panel-head""><div><h2>Onde concentrar a melhoria</h2><p>Impacto em volume e intensidade das falhas</p></div></div>
        <div class=""ld-insights"" data-insights></div>
      </section>
    </div>
    <details class=""ld-panel ld-carrier-detail"">
      <summary>Detalhe de transportadoras</summary>
    <section class=""ld-detail-inner"">
      <div class=""ld-panel-head"">
        <div><h2>Como as transportadoras se comparam</h2><p>Selecione uma coluna para ordenar. As setas de OTIF indicam a posição em relação ao OTIF do recorte.</p></div>
        <button type=""button"" class=""ld-button ld-table-more"" data-table-more aria-expanded=""false"">Mais colunas</button>
      </div>
      <div class=""ld-table-wrap"" tabindex=""0"" aria-label=""Tabela comparativa com rolagem em telas estreitas"">
        <table class=""ld-table"">
          <thead><tr><th scope=""col""><button type=""button"" data-sort=""label"">Transportadora<span aria-hidden=""true"">↕</span></button></th><th scope=""col""><button type=""button"" data-sort=""p"">Pedidos<span aria-hidden=""true"">↕</span></button></th><th scope=""col""><button type=""button"" data-sort=""otif"">OTIF<span aria-hidden=""true"">↕</span></button></th><th scope=""col""><button type=""button"" data-sort=""lead"">Prazo médio<span aria-hidden=""true"">↕</span></button></th><th scope=""col""><button type=""button"" data-sort=""unitCost"">Custo por pedido<span aria-hidden=""true"">↕</span></button></th><th scope=""col"" data-table-extra hidden><button type=""button"" data-sort=""pe"">Elegíveis<span " &
    "aria-hidden=""true"">↕</span></button></th><th scope=""col"" data-table-extra hidden><button type=""button"" data-sort=""misses"">Falhas de OTIF<span aria-hidden=""true"">↕</span></button></th><th scope=""col"" data-table-extra hidden><button type=""button"" data-sort=""cp"">Custo total<span aria-hidden=""true"">↕</span></button></th><th scope=""col"" data-table-extra hidden><button type=""button"" data-sort=""co"">CO₂<span aria-hidden=""true"">↕</span></button></th></tr></thead>
          <tbody data-table></tbody>
        </table>
