    </details>
  </main>
  <div class=""ld-tooltip"" role=""tooltip"" data-tooltip hidden></div>
  <script type=""application/json"" class=""ld-data"">" & Payload &
    "</script>
  <script>(() => {
  'use strict';
  const root = document.currentScript?.closest('.ld-root') ||
    [...document.querySelectorAll('.ld-root:not([data-ld-ready])')].at(-1);
  if (!root || root.hasAttribute('data-ld-ready')) return;
  root.setAttribute('data-ld-ready', '');
  const find = name => root.querySelector('[data-' + name + ']');
  const stateText = find('state');
  const content = find('content');

  try {

  function compareCalendar(meta, month, priorMonth) {
    const daysInMonth = key => {
      const [year, number] = key.split('-').map(Number);
      return new Date(Date.UTC(year, number, 0)).getUTCDate();
    };
    const currentDays = meta.calendarioComparavel?.find(x => x.m === month)?.dias || [];
    if (!currentDays.length || currentDays.length === daysInMonth(month)) {
      return { partial: false, days: null };
    }
    const days = currentDays.filter(day => day <= daysInMonth(priorMonth));
    return { partial: true, days: new Set(days), label: days.length ?
      days.at(-1) - days[0] + 1 === days.length ?
        'dias ' + days[0] + '–' + days.at(-1) : days.length + ' dias equivalentes' : null };
  }
  function monthIsPartial(meta, month) {
    const next = new Date(month + '-01T00:00:00Z');
    next.setUTCMonth(next.getUTCMonth() + 1);
    next.setUTCDate(0);
    const row = meta.calendarioComparavel?.find(x => x.m === month);
    return Boolean(row?.dias.length && row.dias.length < next.getUTCDate());
  }
    const data = JSON.parse(root.querySelector('.ld-data').textContent);
    if (!Array.isArray(data.baseInterativa) || !data.meta || !data.kpis) throw new Error('Estrutura de dados incompleta');
    const base = data.baseInterativa;
    const comparison = data.baseComparacao || [];
    const fields = [['m', 'Mês'], ['r', 'Região'], ['c', 'Categoria'], ['t', 'Transportadora'], ['o', 'Modal']]
      .filter(([key]) => !base.length || base.some(row => key in row));
    const memory = globalThis[Symbol.for('logistics.analytics.dash" &
    "board')] ??= { theme: 'light', filters: {} };
    const selected = memory.filters;
    const selects = new Map();
    const number = new Intl.NumberFormat('pt-BR');
    const decimal = new Intl.NumberFormat('pt-BR', { maximumFractionDigits: 2 });
    const percent = new Intl.NumberFormat('pt-BR', { style: 'percent', minimumFractionDigits: 1, maximumFractionDigits: 1 });
    const currency = new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' });
    const monthShort = new Intl.DateTimeFormat('pt-BR', { month: 'short', timeZone: 'UTC' });
    const monthLong = new Intl.DateTimeFormat('pt-BR', { month: 'long', year: 'numeric', timeZone: 'UTC' });
    const clock = new Intl.DateTimeFormat('pt-BR', { dateStyle: 'short', timeStyle: 'short', timeZone: 'America/Sao_Paulo' });
    const collator = new Intl.Collator('pt-BR');
    const fmt = (value, formatter = number, unit = '') => value == null ? '—' : formatter.format(value) + unit;
    const ratio = (numerator, denominator) => denominator ? numerator / denominator : null;
    const monthDate = key => new Date(key + '-01T00:00:00Z');
    const monthLabel = key => key ? monthLong.format(monthDate(key)) : '—';
    const compactMonth = key => monthShort.format(monthDate(key)).replace('.', '') + '/' + key.slice(2, 4);
    const previousMonth = key => {
      const date = monthDate(key);
      date.setUTCMonth(date.getUTCMonth() - 1);
      return date.toISOString().slice(0, 7);
    };
    const add = (tag, className, text) => {
      const el = document.createElement(tag);
      if (className) el.className = className;
      if (text != null) el.textContent = text;
      return el;
    };
    const tally = rows => {
      const sum = key => rows.reduce((total, row) => total + (row[key] ?? 0), 0);
      const p = sum('p'), q = sum('q'), pe = sum('pe'), ln = sum('ln'), cp = sum('cp');
      return {
        p, q, pe, cp, ln, qt: sum('qt'), delay: ratio(sum('at'), sum('an')), co: sum('co'), pa: sum('pa'), en: sum" &
    "('en'), ea: sum('ea'),
        dv: sum('dv'), av: sum('av'), ex: sum('ex'), misses: pe - q,
        otif: ratio(q, pe), lead: ratio(sum('lt'), ln), unitCost: ratio(cp, p)
      };
    };
    const group = (rows, key) => {
      const buckets = new Map();
      for (const row of rows) {
        if (row[key] == null) continue;
        if (!buckets.has(row[key])) buckets.set(row[key], []);
        buckets.get(row[key]).push(row);
      }
      return [...buckets].map(([label, items]) => ({ label, ...tally(items) }));
    };
    const descending = (items, key) =>
      [...items].sort((a, b) => (b[key] ?? -Infinity) - (a[key] ?? -Infinity) || collator.compare(a.label, b.label));
    const ascendingOtif = items => [...items].sort((a, b) =>
      (a.otif ?? Infinity) - (b.otif ?? Infinity) || b.pe - a.pe || collator.compare(a.label, b.label));
    const median = values => {
      const sorted = values.filter(value => value != null).sort((a, b) => a - b);
      if (!sorted.length) return null;
      const middle = Math.floor(sorted.length / 2);
      return sorted.length % 2 ? sorted[middle] : (sorted[middle - 1] + sorted[middle]) / 2;
    };
    const tooltip = find('tooltip');
    const closeTooltip = () => { tooltip.hidden = true; };
    const showTooltip = (target, text) => {
      const anchor = target.getBoundingClientRect();
      const area = root.getBoundingClientRect();
      tooltip.textContent = text;
      const onPlot = target.classList.contains('ld-hit');
      const plot = onPlot ? chart.getBoundingClientRect() : null;
      const left = plot ? plot.left - area.left + 59 : 8;
      const right = plot ? plot.right - area.left - 20 : area.width - 8;
      tooltip.style.maxWidth = 'min(290px, ' + Math.max(1, right - left) + 'px)';
      tooltip.hidden = false;
      const x = anchor.left - area.left + (anchor.width - tooltip.offsetWidth) / 2;
      tooltip.style.left = Math.max(left, Math.min(right - tooltip.offsetWidth, x)) + 'px';
      const above = anchor." &
    "top - area.top - tooltip.offsetHeight - 6;
      const below = anchor.bottom - area.top + 6;
      tooltip.style.top = (plot ? plot.top - area.top + 31 :
        Math.max(4, Math.min(area.height - tooltip.offsetHeight - 4, above < 4 ? below : above))) + 'px';
    };
    const describe = row => row.label + '\n' +
      fmt(row.p) + ' pedidos · ' + fmt(row.pe) + ' elegíveis\n' +
      'OTIF ' + fmt(row.otif, percent) + ' · ' + fmt(row.misses) + ' falhas\n' +
      'Custo ' + fmt(row.cp, currency) + '\n' +
      'Lead time ' + fmt(row.lead, decimal, ' dias') + ' · CO₂ ' + fmt(row.co, decimal, ' kg');
    const bindDetails = (target, text) => {
      target.setAttribute('tabindex', '0');
      target.setAttribute('aria-label', text.replaceAll('\n', '. '));
      target.addEventListener('mouseenter', () => showTooltip(target, text));
      target.addEventListener('mouseleave', closeTooltip);
      target.addEventListener('focus', () => showTooltip(target, text));
      target.addEventListener('blur', closeTooltip);
      target.addEventListener('click', () => showTooltip(target, text));
    };

    const source = data.meta.fonte?.split(' / ').at(-1);
    const brDate = value => value.split('-').reverse().join('/');
    find('source').textContent = source ? (data.meta.baseSimulada ? 'Base simulada · ' : 'Fonte · ') + source : 'Fonte indisponível';
    find('reference').textContent = data.meta.fonteAtualizadaEm ? 'Referência da base · ' + brDate(data.meta.fonteAtualizadaEm) : 'Referência da base indisponível';
    const now = new Date();
    find('rendered').dateTime = now.toISOString();
    find('rendered').textContent = 'Gerado em ' + clock.format(now) + ' (Brasília)';

    const filterBox = find('filter-box');
    let compact;
    const fitFilters = () => {
      const next = root.clientWidth - parseFloat(getComputedStyle(root).paddingLeft) - parseFloat(getComputedStyle(root).paddingRight) <= 685;
      if (next !== compact) {
        filterBox.open = !next;
        com" &
    "pact = next;
      }
    };
    fitFilters();
    const themeButton = find('theme-switch');
    const applyTheme = () => {
      const dark = memory.theme === 'dark';
      root.dataset.theme = dark ? 'dark' : 'light';
      themeButton.setAttribute('aria-pressed', String(dark));
      themeButton.textContent = dark ? 'Modo escuro · ligado' : 'Modo escuro';
    };
    themeButton.addEventListener('click', () => {
      memory.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
      applyTheme();
    });
    applyTheme();

    for (const [key, label] of fields) {
      const wrapper = add('label', 'ld-field', label);
      const select = add('select');
      select.dataset.filter = key;
      const values = [...new Set(base.map(row => row[key]).filter(value => value != null))].sort(collator.compare);
      select.append(new Option('Todos', ''));
      for (const value of values) select.append(new Option(key === 'm' ? monthLabel(value) : value, value));
      if (selected[key] && !values.includes(selected[key])) {
        const label = key === 'm' ? monthLabel(selected[key]) : selected[key];
        select.append(new Option(label + ' · fora do recorte', selected[key]));
      }
      select.value = selected[key] || '';
      select.disabled = !base.length && !selected[key];
      select.addEventListener('change', () => {
        selected[key] = select.value;
        render();
      });
      selects.set(key, select);
      wrapper.append(select);
      find(key === 'm' || key === 'r' ? 'fields' : 'extra-fields').append(wrapper);
    }
    find('clear').addEventListener('click', () => {
      for (const [key, select] of selects) {
        delete selected[key];
        select.value = '';
        select.disabled = !base.length;
      }
      render();
    });
    root.addEventListener('keydown', e => { if (e.key === 'Escape') closeTooltip(); });

  function mountPickers(root) {
    const refreshers = [];
    let closeActive = null;
    for (const select of root.qu" &
    "erySelectorAll('select')) {
      const label = select.parentElement;
      const caption = label.textContent.replace(select.textContent, '').trim();
      const field = document.createElement('div');
      field.className = label.className || 'ld-field';
      field.setAttribute('data-hc-suppress', 'all');
      const title = document.createElement('span');
      title.textContent = caption;
      const picker = document.createElement('div');
      picker.className = 'ld-picker';
      const toggle = document.createElement('button');
      toggle.type = 'button';
      toggle.setAttribute('aria-haspopup', 'listbox');
      toggle.setAttribute('aria-expanded', 'false');
      const list = document.createElement('ul');
      list.className = 'ld-picker-list';
      list.setAttribute('role', 'listbox');
      list.setAttribute('aria-label', caption);
      list.hidden = true;
      select.hidden = true;
      label.replaceWith(field);
      field.append(title, select, picker);
      picker.append(toggle, list);

      const refresh = () => {
        const current = select.selectedOptions[0]?.label || 'Sem opções';
        toggle.textContent = current;
        toggle.setAttribute('aria-label', caption + ': ' + current);
        toggle.disabled = select.disabled;
      };
      const close = (restore = false) => {
        list.hidden = true;
        toggle.setAttribute('aria-expanded', 'false');
        if (closeActive === close) closeActive = null;
        if (restore) toggle.focus({ preventScroll: true });
      };
      const open = (last = false) => {
        closeActive?.();
        closeActive = close;
        const control = toggle.getBoundingClientRect();
        const bottom = document.documentElement.clientHeight;
        const below = bottom - control.bottom - 8;
        const above = control.top - 8;
        const flip = below < Math.min(240, select.options.length * 38 + 10) && above > below;
        picker.toggleAttribute('data-above', flip);
        list.s" &
    "tyle.maxHeight = Math.max(80, Math.min(300, flip ? above : below)) + 'px';
        const options = [...select.options].map((option, index) => {
          const item = document.createElement('li');
          item.setAttribute('role', 'option');
          item.setAttribute('aria-selected', String(option.selected));
          item.tabIndex = -1;
          item.textContent = option.label;
          item.addEventListener('click', () => {
            select.selectedIndex = index;
